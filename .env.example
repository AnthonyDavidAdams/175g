# --- Core ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://175g.com
DATABASE_PATH=/data/175g.db

# --- TD agent -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (magic links + approved outreach) ----------------------------
# Without AWS credentials the app logs emails to the console instead of
# sending, so magic links still work in local development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=175g <no-reply@175g.com>

# --- Operations ---------------------------------------------------------
# /admin is HTTP-basic-auth protected with this password (any username).
ADMIN_PASSWORD=
# Umami analytics; leave blank to ship no tracker.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Seed the public demo tournament on boot (local / showcase instances only).
SEED_DEMO=

# --- Public agent (the landing page) ------------------------------------
# The landing page is a conversation with the agent before sign-in. It spends
# API tokens for anonymous visitors, so it is rate-limited per IP and capped per
# day. Set PUBLIC_AGENT=0 to fall back to a plain sign-in / start form.
PUBLIC_AGENT=1
PUBLIC_AGENT_PER_IP_HOURLY=12
PUBLIC_AGENT_DAILY_CAP=300

# --- Telegram bot -------------------------------------------------------
# Register the webhook with the same secret so nobody else can post scores:
#   curl "https://api.telegram.org/bot$TOKEN/setWebhook?url=https://175g.com/api/telegram&secret_token=$SECRET"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
