# --- Core ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://175g.com
DATABASE_PATH=/data/175g.db

# --- TD agent -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (magic links + approved outreach) ----------------------------
# Without AWS credentials the app logs emails to the console instead of
# sending, so magic links still work in local development.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=175g <no-reply@175g.com>

# --- Telegram bot -------------------------------------------------------
# Register the webhook with the same secret so nobody else can post scores:
#   curl "https://api.telegram.org/bot$TOKEN/setWebhook?url=https://175g.com/api/telegram&secret_token=$SECRET"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
